{
  "Modules": {
    "YOLO26LSurveillance960": {
      "Name": "YOLO26L Surveillance 960 (Test)",
      "Version": "0.2.0-test",
      "PublishingInfo": {
        "Description": "Isolated YOLO26l 960x960 surveillance inference test. Eight filtered COCO classes; DirectML.",
        "Category": "Computer Vision",
        "Stack": "Python, ONNX Runtime, YOLO26",
        "License": "Development",
        "Author": "Craig McDaniel",
        "BasedOn": "Ultralytics YOLO26",
        "BasedOnUrl": "https://github.com/ultralytics/ultralytics"
      },
      "LaunchSettings": {
        "AutoStart": false,
        "FilePath": "detect_adapter.py",
        "Runtime": "python3.12",
        "RuntimeLocation": "Local",
        "PostStartPauseSecs": 1,
        "Queue": "yolo26l_surveillance_960_queue",
        "Parallelism": 1
      },
      "GpuOptions": {
        "InstallGPU": true,
        "EnableGPU": true,
        "AcceleratorDeviceName": null,
        "HalfPrecision": "enable"
      },
      "InstallOptions": {
        "Platforms": [
          "all",
          "!windows-arm64"
        ],
        "ModuleReleases": [
          {
            "ModuleVersion": "0.2.0-test",
            "ServerVersionRange": [
              "2.9.4",
              ""
            ],
            "ReleaseDate": "2026-11-13",
            "ReleaseNotes": "Isolated YOLO26l-960 test module."
          }
        ]
      },
      "ModelRequirements": [
        {
          "Task": "Object Detection",
          "Architecture": "YOLO26",
          "Format": "ONNX"
        }
      ],
      "RouteMaps": [
        {
          "Name": "YOLO26L Surveillance 960 Test",
          "Route": "vision/yolo26l-surveillance-960",
          "Method": "POST",
          "Command": "detect",
          "Description": "Test 960px filtered eight-class YOLO26l independently of production YOLO26s.",
          "Inputs": [
            {
              "Name": "image",
              "Type": "File",
              "Description": "The image to analyze."
            },
            {
              "Name": "min_confidence",
              "Type": "Float",
              "Description": "Minimum confidence from 0.0 to 1.0.",
              "DefaultValue": 0.4,
              "MinValue": 0,
              "MaxValue": 1
            }
          ],
          "Outputs": [
            {
              "Name": "success",
              "Type": "Boolean",
              "Description": "True if successful."
            },
            {
              "Name": "message",
              "Type": "String",
              "Description": "Summary of the inference operation."
            },
            {
              "Name": "error",
              "Type": "String",
              "Description": "Error information if unsuccessful."
            },
            {
              "Name": "predictions",
              "Type": "Object[]",
              "Description": "Detected objects."
            },
            {
              "Name": "count",
              "Type": "Integer",
              "Description": "Number of objects detected."
            },
            {
              "Name": "inferenceMs",
              "Type": "Integer",
              "Description": "Inference time in milliseconds."
            },
            {
              "Name": "processMs",
              "Type": "Integer",
              "Description": "Total processing time in milliseconds."
            }
          ]
        }
      ]
    }
  }
}
